FROM docker.io/eclipse-temurin:21.0.11_10-jdk-noble@sha256:15ec53e5373fbede42fb2c1ec5b7e3ccbe1b0c9ad232ed67a16ed1b8b47070b6 AS base

# Stage 1: base
# Minimal environment with only system tools. This stage is stable and reusable across merges.

RUN apt-get install -y --no-install-recommends --update \
      curl \
      fd-find \
      git \
      make \
      ripgrep \
      rustup \
      unzip \
      python3 \
 && rm -rf /var/lib/apt/lists/*

# Set a default Git identity
RUN git config --global user.name "builder" \
 && git config --global user.email "builder@docker.local"

FROM base AS toolchain

# Stage 2: toolchain
# Language SDKs, compilers, and build tools.

# Install Android SDK
ARG ANDROID_SDK_DIST="commandlinetools-linux-13114758_latest.zip"
ARG ANDROID_SDK_SHA256="7ec965280a073311c339e571cd5de778b9975026cfcbe79f2b1cdcb1e15317ee"
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin"

RUN set -eux; \
    curl -fS "https://dl.google.com/android/repository/$ANDROID_SDK_DIST" -o sdk.zip; \
    printf '%s  %s\n' "$ANDROID_SDK_SHA256" "sdk.zip" | sha256sum -c; \
    mkdir -p "$ANDROID_HOME"; \
    unzip -q sdk.zip -d "$ANDROID_HOME/cmdline-tools/"; \
    rm sdk.zip; \
    mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest"; \
    yes | sdkmanager --licenses; \
    sdkmanager "platform-tools"

ARG NDK_VERSION="28.0.13004108"
RUN sdkmanager "ndk;$NDK_VERSION"

ENV ANDROID_NDK_HOME="$ANDROID_HOME/ndk/$NDK_VERSION"

ARG BUILD_TOOLS_VERSION="36.0.0"
RUN sdkmanager "build-tools;${BUILD_TOOLS_VERSION}"

ARG COMPILE_SDK="android-34"
RUN sdkmanager "platforms;${COMPILE_SDK}"

# Install protoc from GitHub releases
ARG PROTOC_VERSION="29.6"
ARG PROTOC_SHA256="48785a926e73ffa3f68e2f22b14e7b849620c7a1d36809ac9249a5495e280323"
RUN set -eux; \
    curl -fSL "https://github.com/protocolbuffers/protobuf/releases/download/v$PROTOC_VERSION/protoc-$PROTOC_VERSION-linux-x86_64.zip" -o protoc.zip; \
    printf '%s  %s\n' "$PROTOC_SHA256" "protoc.zip" | sha256sum -c; \
    mkdir -p /opt/protoc; \
    unzip -q protoc.zip -d /opt/protoc/; \
    rm protoc.zip; \
    ln -sf /opt/protoc/bin/protoc /usr/local/bin/protoc; \
    protoc --version; \
    test "$(protoc --version)" = "libprotoc $PROTOC_VERSION"

# Install build tools pinned to a fixed timestamp via snapshot service
ARG APT_SNAPSHOT_ID=20260703T000000Z
RUN apt-get update --snapshot "$APT_SNAPSHOT_ID" \
 && apt-get install -y --no-install-recommends \
      clang \
      cmake \
      crossbuild-essential-arm64 \
 && rm -rf /var/lib/apt/lists/*

# Pre-fetch Gradle wrapper
COPY java/gradlew /libsignal/java/
COPY java/gradle/wrapper /libsignal/java/gradle/wrapper
RUN /libsignal/java/gradlew --version

# Set optional read-only Gradle cache (mount at runtime)
ENV GRADLE_RO_DEP_CACHE=/.gradle-ro-cache

# Install Rust toolchain and targets
COPY rust-toolchain /libsignal/
RUN rustup toolchain install "$(cat /libsignal/rust-toolchain)" --profile minimal \
      --target aarch64-linux-android \
      --target armv7-linux-androideabi \
      --target x86_64-linux-android \
      --target aarch64-unknown-linux-gnu \
      --no-self-update

FROM toolchain AS source

# Stage 3: source
# Full project source tree.

WORKDIR /libsignal
COPY . .

# If a Git checkout is present, remove untracked files so builds start from a clean tree.
RUN test ! -e .git || git clean -ffdx

FROM source AS deps-overlay

# Stage 4: deps-overlay
# Hook for pre-built dependencies, supplied via named build contexts.

# This project has none, so the stage is an empty alias of source.

FROM deps-overlay AS assemble

# Stage 5: assemble
# Build stage for the project.
# Can be overridden with a prebuilt image via:
#  --build-context assemble=docker-image://<image>

RUN make assemble

FROM scratch AS artifacts

# Stage 6: artifacts
# Build outputs only, laid out exactly as consumers expect.

COPY --from=assemble /root/.m2/repository/ /

FROM deps-overlay AS default

# Stage 7: default
# Runnable build environment without prebuilt outputs.
# Left as the final stage so it becomes the default target.

ENTRYPOINT ["make"]
CMD ["help"]
